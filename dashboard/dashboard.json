{"datasets": [{"name": "ds_prio", "displayName": "Prio", "queryLines": ["SELECT p.service_label AS service, CASE split(scenario_id, '[|]')[0] WHEN 'optimistic' THEN 'Optimistic' WHEN 'base' THEN 'Base' ELSE 'Pessimistic' END AS scenario,\n", "  CASE WHEN scenario_id LIKE '%|hsg' THEN 'Targets met' ELSE 'Not met' END AS prevention, p.planning_area, p.cluster, p.rank, p.unit,\n", "  ROUND(p.gap_2026) AS gap_now, ROUND(p.gap_2031) AS gap_2031, p.next_step, p.next_step_reason, p.confidence,\n", "  CASE WHEN p.gap_start IS NULL THEN 'No gap by 2031' WHEN p.gap_start <= 2026 THEN 'Already today'\n", "       ELSE CAST(CAST(p.gap_start AS INT) AS STRING) END AS short_from,\n", "  p.stability_share, p.presets_in_top5, m.lat, m.lon\n", "FROM service_priorities p JOIN planning_area_meta m ON p.pa_key = m.pa_key\n"], "catalog": "workspace", "schema": "healthpulse_gold"}, {"name": "ds_nat", "displayName": "Nat", "queryLines": ["SELECT service_label AS service, CASE split(scenario_id, '[|]')[0] WHEN 'optimistic' THEN 'Optimistic' WHEN 'base' THEN 'Base' ELSE 'Pessimistic' END AS scenario,\n", "  CASE WHEN scenario_id LIKE '%|hsg' THEN 'Targets met' ELSE 'Not met' END AS prevention, cluster, make_date(year, 6, 30) AS year_date, year,\n", "  need, capacity, GREATEST(gap, 0) AS shortfall, unit\n", "FROM service_area_year\n"], "catalog": "workspace", "schema": "healthpulse_gold"}, {"name": "ds_kpi", "displayName": "Kpi", "queryLines": ["SELECT service_label AS service, CASE split(scenario_id, '[|]')[0] WHEN 'optimistic' THEN 'Optimistic' WHEN 'base' THEN 'Base' ELSE 'Pessimistic' END AS scenario,\n", "  CASE WHEN scenario_id LIKE '%|hsg' THEN 'Targets met' ELSE 'Not met' END AS prevention, cluster, need AS need_2031, capacity AS capacity_2031,\n", "  GREATEST(gap, 0) AS gap_2031, pop65 AS seniors_2031\n", "FROM service_area_year WHERE year = 2031\n"], "catalog": "workspace", "schema": "healthpulse_gold"}, {"name": "ds_monthly", "displayName": "Monthly", "queryLines": ["SELECT month, 